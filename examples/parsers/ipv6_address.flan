from ipv4_address import IPv4Address

// RFC 3986 IPv6 address
// https://www.rfc-editor.org/info/rfc3986/#appendix-A
lang H16 = r'[0-9a-fA-F]{1,4}'
lang LS32 = (H16 ":" H16) | IPv4Address
lang IPv6Address =                            (H16 ":"){6} LS32     \
                 |                       "::" (H16 ":"){5} LS32     \
                 |                  H16? "::" (H16 ":"){4} LS32     \
                 | ((H16 ":"){0,1} H16)? "::" (H16 ":"){3} LS32     \
                 | ((H16 ":"){0,2} H16)? "::" (H16 ":"){2} LS32     \
                 | ((H16 ":"){0,3} H16)? "::"  H16 ":"     LS32     \
                 | ((H16 ":"){0,4} H16)? "::"              LS32     \
                 | ((H16 ":"){0,5} H16)? "::"              H16      \
                 | ((H16 ":"){0,6} H16)? "::"

from ipv4_address import parse_ipv4_address

val HEXTET_COUNT = 8

def parse_ipv6_address(ip_str: IPv6Address) -> Int:
    if ip_str == "":
        raise "Address cannot be empty"
    if |ip_str| > 45:
        raise "At most 45 characters expected"

    var _max_parts = HEXTET_COUNT + 1
    var parts = ip_str.split(':')

    // An IPv6 address needs at least 2 colons (3 parts).
    var _min_parts = 3
    if |parts| < _min_parts:
        raise "At least 3 parts expected"

    // If the address has an IPv4-style suffix, convert it to hexadecimal.
    if '.' in parts.last:
        var ipv4_int = parse_ipv4_address(parts.last)
        parts = parts.init
        parts += ["%x" % ((ipv4_int >> 16) & 0xFFFF),
                  "%x" % (ipv4_int & 0xFFFF)]

    // An IPv6 address can't have more than 8 colons (9 parts).
    // The extra colon comes from using the "::" notation for a single
    // leading or trailing zero part.
    if |parts| > _max_parts:
        raise "At most 8 colons permitted"

    // Disregarding the endpoints, find '::' with nothing in between.
    // This indicates that a run of zeroes has been skipped.
    var skip_index = -1
    var i = 1
    var len = |parts|
    while i < len - 1:
        invariant 1 <= i < len
        invariant skip_index != -1 ? skip_index < i && skip_index == parts.indexOf("", 1) : "" !in parts[1:i]
        if parts[i] == "":
            if skip_index != -1:
                // Can't have more than one '::'
                raise "At most one '::' permitted"
            skip_index = i
        i += 1

    // parts_hi is the number of parts to copy from above/before the '::'
    // parts_lo is the number of parts to copy from below/after the '::'
    var parts_hi = 0
    var parts_lo = 0
    var parts_skipped = 0
    if skip_index != -1:
        // If we found a '::', then check if it also covers the endpoints.
        var parts_hi = skip_index
        var parts_lo = (|parts|) - skip_index - 1
        if parts[0] == "":
            parts_hi -= 1
            if parts_hi != 0:
                raise "Leading ':' only permitted as part of '::'"
        if parts.last == "":
            parts_lo -= 1
            if parts_lo != 0:
                raise "Trailing ':' only permitted as part of '::'"
        var parts_skipped = HEXTET_COUNT - (parts_hi + parts_lo)
        if parts_skipped < 1:
            raise "Expected at most 7 other parts with '::'"
    else:
        // Otherwise, allocate the entire address to parts_hi.  The
        // endpoints could still be empty, but _parse_hextet() will check
        // for that.
        if |parts| != HEXTET_COUNT:
            raise "Exactly 8 parts expected without '::'"
        if parts[0] == "":
            raise "Leading ':' only permitted as part of '::'"
        if parts.last == "":
            raise "Trailing ':' only permitted as part of '::'"
        parts_hi = |parts|
        parts_lo = 0
        parts_skipped = 0

    // Now, parse the hextets into a 128-bit integer.
    var ip_int = 0
    i = 0
    while i < parts_hi:
        invariant 0 <= i <= parts_hi
        ip_int <<= 16
        ip_int |= _parse_hextet(parts[i])
        i += 1
    ip_int <<= 16 * parts_skipped
    len = |parts|
    i = len - parts_lo
    while i < |parts|:
        invariant len - parts_lo <= i <= |parts|
        ip_int <<= 16
        ip_int |= _parse_hextet(parts[i])
        i += 1
    return ip_int

def _parse_hextet(hextet: H16) -> Int