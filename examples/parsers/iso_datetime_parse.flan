// import from iso_date_parse.flan
lang Year = r"[0-9]{4}"
lang Month = r"0[1-9]|1[0-2]"
lang Day = r"0[1-9]|[12][0-9]|3[01]"
lang CalendarDate = Year Month Day | Year '-' Month '-' Day

lang Week = r"W(0[1-9]|[1-4][0-9]|5[0-3])"
lang Weekday = r"[1-7]"
lang WeekDate = Year Week Weekday? | Year '-' Week ('-' Weekday)?
lang Date = CalendarDate | WeekDate

method _parse_iso_format_date(dstr: Date) returns (year: int, month: int, day: int)
  ensures 0 <= year && year <= 9999
  ensures 1 <= month && month <= 12
  ensures 1 <= day && day <= 31

// import from iso_time_parse.flan
lang Hour = r"[0-1][0-9]|2[0-3]"
lang Minute = r"[0-5][0-9]"
lang Second = r"[0-5][0-9]"
lang Fraction = r"[0-9]+"
lang RawTime = Hour (":" Minute (":" Second ("." Fraction)?)?)?
             | Hour (Minute (Second (("."|",") Fraction)?)?)?

lang TimeZone = ("+"|"-") RawTime
lang Time = RawTime TimeZone

const SECOND = 1000000
const MINUTE = 60 * SECOND
const HOUR = 60 * MINUTE

method _parse_iso_format_time(tstr: Time)
  returns (hour: int, minute: int, second: int, microsecond: int, utcoffset: int)
  ensures 0 <= hour && hour < 24
  ensures 0 <= minute && minute < 60
  ensures 0 <= second && second < 60
  ensures 0 <= microsecond && microsecond < 1000000
  ensures -24*HOUR <= utcoffset && utcoffset <= 24*HOUR

method _is_ascii_digit(c: char): bool
  ensures _ == (c in "0123456789")

lang DateTime = Date "T" Time

// main
method from_iso_format(date_string: DateTime)
  returns (year: int, month: int, day: int,
           hour: int, minute: int, second: int, microsecond: int, utcoffset: int)
  ensures 0 <= year && year <= 9999
  ensures 1 <= month && month <= 12
  ensures 1 <= day && day <= 31
  ensures 0 <= hour && hour < 24
  ensures 0 <= minute && minute < 60
  ensures 0 <= second && second < 60
  ensures 0 <= microsecond && microsecond < 1000000
  ensures -24*HOUR <= utcoffset && utcoffset <= 24*HOUR
{
  if |date_string| < 7 {
    abort "Invalid isoformat string";
  }

  var separator_location = _find_iso_format_datetime_separator(date_string);
  var dstr = date_string[0:separator_location];
  var tstr = date_string[(separator_location+1):];

  (year, month, day) = _parse_iso_format_date(dstr);

  if tstr != "" {
    (hour, minute, second, microsecond, utcoffset) = _parse_iso_format_time(tstr);
  } else {
    (hour, minute, second, microsecond, utcoffset) = (0, 0, 0, 0, 0);
  }
}

method _find_iso_format_datetime_separator(dtstr: DateTime) returns (index: int)
  ensures index == dtstr.indexOf('T')
{
  var len_dtstr = |dtstr|;
  assert len_dtstr > 7;
  var date_separator = '-';
  var week_indicator = 'W';

  if dtstr[4] == date_separator {
    if dtstr[5] == week_indicator {
      if len_dtstr < 8 {
        abort "Invalid ISO string";
      }
      if len_dtstr > 8 && dtstr[8] == date_separator {
        // YYYY-Www-D (10)
        if len_dtstr == 9 {
          abort "Invalid ISO string";
        }
        return 10;
      } else {
        // YYYY-Www (8)
        return 8;
      }
    } else {
      // YYYY-MM-DD (10)
      return 10;
    }
  } else {
    if dtstr[4] == week_indicator {
      // YYYYWww (7) or YYYYWwwd (8)
      if !_is_ascii_digit(dtstr[7]) {
        return 7;
      } else {
        return 8;
      }
    } else {
      // YYYYMMDD (8)
      return 8;
    }
  }
}