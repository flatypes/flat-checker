from url_split import Scheme, Authority, Path, Query, Fragment, URL, RelativePath

def url_unsplit(scheme: Scheme?, netloc: Authority?, path: Path, query: Query?, fragment: Fragment?) -> URL:
    requires scheme is None ==> path in RelativePath
    url: str = path
    if netloc is not None:
        if url != "" and url[:1] != "/":
            url = "/" + url
        url = "//" + netloc + url
    elif url[:2] == "//":
        url = "//" + url
    if scheme is not None and scheme != "":
        url = scheme + ":" + url
    if query is not None:
        url = url + "?" + query
    if fragment is not None:
        url = url + "#" + fragment
    return url
