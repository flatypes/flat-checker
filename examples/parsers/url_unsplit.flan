from url_split import Scheme, Authority, Path, Query, Fragment, URL, RelativePath

def url_unsplit(scheme: Scheme?, netloc: Authority?, path: Path, query: Query?, fragment: Fragment?) -> URL:
    requires scheme == None ==> path in RelativePath
    var url: Str = path
    if netloc != None:
        if url != "" and url[:1] != "/":
            url = "/" + url
        url = "//" + netloc + url
    else if url[:2] == "//":
        url = "//" + url
    if scheme != None and scheme != "":
        url = scheme + ":" + url
    if query != None:
        url = url + '?' + query
    if fragment != None:
        url = url + '#' + fragment
    return url