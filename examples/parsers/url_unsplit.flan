def url_unsplit(scheme: str?, netloc: str?, path: str, query: str?, fragment: str?) -> str:
    var url = path
    if netloc != null:
        if url != '' && url[:1] != '/':
            url = '/' + url
        url = '//' + netloc + url
    else if url[:2] == '//':
        url = '//' + url
    if scheme != null && scheme != '':
        url = scheme + ':' + url
    if query != null:
        url = url + '?' + query
    if fragment != null:
        url = url + '#' + fragment
    return url
