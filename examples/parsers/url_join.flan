from url_unsplit import Scheme, Authority, Path, Query, Fragment, URL, url_unsplit, RelativePath

val uses_relative = ['', 'ftp', 'http']
val uses_netloc = ['', 'ftp', 'http']

def url_split(url: URL) -> (Scheme?, Authority?, Path, Query?, Fragment?):
    ensures lambda (scheme, netloc, path, query, fragment) -> scheme == null ==> path in RelativePath

/** Join a base URL and a possibly relative URL to form an absolute
    interpretation of the latter. */
def url_join(base: URL, url: URL) -> URL:
    if base == '':
        return url
    if url == '':
        return base

    var (b_scheme, b_netloc, b_path, b_query, b_fragment) = url_split(base)
    var (scheme, netloc, path, query, fragment) = url_split(url)

    if scheme == null:
        scheme = b_scheme
    if scheme != b_scheme || (scheme != null && scheme != '' && scheme !in uses_relative):
        return url
    if (scheme == null || scheme == '') || scheme in uses_netloc:
        if netloc != null && netloc != '':
            return url_unsplit(scheme, netloc, path, query, fragment)
        netloc = b_netloc

    if path == '':
        path = b_path
        if query == null:
            query = b_query
            if fragment == null:
                fragment = b_fragment
        return url_unsplit(scheme, netloc, path, query, fragment)

    var base_parts = b_path.split('/')
    if base_parts.last != '':
        // the last item is not a directory, so will not be taken into account
        // in resolving the relative path
        base_parts = base_parts.init

