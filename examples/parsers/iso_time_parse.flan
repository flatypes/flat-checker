# ISO 8601 Times
lang HH = r"[01][0-9]|2[0-3]"
lang MM = r"[0-5][0-9]"
lang SS = r"[0-5][0-9]"
lang Fraction = r"[.,][0-9]+"
lang Format = HH (MM (SS Fraction?)?)? | HH (":" MM (":" SS Fraction?)?)?

lang TZStr = "" | "Z" | ("+"|"-") Format
lang TimeStr = Format TZStr

type Hour = {h: int | 0 <= h < 24}
type Minute = {m: int | 0 <= m < 60}
type Second = {s: int | 0 <= s < 60}
SECOND = 1_000_000  # 1 second = 1,000,000 microseconds
type Microsecond = {us: int | 0 <= us < SECOND}

# UTC offset is encoded as the time difference from UTC in microseconds.
MINUTE = 60 * SECOND
HOUR = 60 * MINUTE
type UTCOffset = {off: int | -24 * HOUR < off < 24 * HOUR}
type Time = (Hour, Minute, Second, Microsecond, UTCOffset?)

def parse_iso_format_time(tstr: TimeStr) -> Time:
    len_str = len(tstr)
    if len_str < 2:
        raise "Iso format time too short"

    tz_pos = tstr.find('-') + 1
    if tz_pos == 0:
        tz_pos = tstr.find('+') + 1
    if tz_pos == 0:
        tz_pos = tstr.find('Z') + 1
    time_str = tstr[:tz_pos-1] if tz_pos > 0 else tstr

    hour, minute, second, microsecond = _parse_hh_mm_ss_ff(time_str)
    # NOTE: We do not consider the special case for 24:00:00.

    tzi: UTCOffset? = None
    if tz_pos == len_str and tstr[len(tstr)-1] == 'Z':
        tzi = 0
    elif tz_pos > 0:
        tz_str = tstr[tz_pos:]

        # Valid time zone strings are:
        # HH                  len: 2
        # HHMM                len: 4
        # HH:MM               len: 5
        # HHMMSS              len: 6
        # HHMMSS.f+           len: 7+
        # HH:MM:SS            len: 8
        # HH:MM:SS.f+         len: 10+

        if len(tz_str) in {0, 1, 3} or tstr[tz_pos-1] == 'Z':
            raise "Malformed time zone string"

        tz_hour, tz_minute, tz_second, tz_microsecond = _parse_hh_mm_ss_ff(tz_str)

        if tz_hour == 0 and tz_minute == 0 and tz_second == 0 and tz_microsecond == 0:
            tzi = 0
        else:
            tz_sign = -1 if tstr[tz_pos - 1] == '-' else 1
            td = tz_hour * HOUR + tz_minute * MINUTE + tz_second * SECOND + tz_microsecond
            tzi = tz_sign * td

    return (hour, minute, second, microsecond, tzi)

_FRACTION_CORRECTION = [100000, 10000, 1000, 100, 10]
ascii_digits = "0123456789"

def _parse_hh_mm_ss_ff(tstr: Format) -> (Hour, Minute, Second, Microsecond):
    len_str = len(tstr)

    time_comps = [0, 0, 0, 0]
    pos = 0
    for comp in range(0, 3):
        if (len_str - pos) < 2:
            raise "Incomplete time component"

        time_comps[comp] = int(tstr[pos:pos+2])

        pos += 2
        next_char = tstr[pos:pos+1]

        if comp == 0:
            has_sep = next_char == ":"

        if next_char == "" or comp >= 2:
            break

        if has_sep and next_char != ":":
            raise "Invalid time separator"

        pos += 1 if has_sep else 0

    if pos < len_str:
        if tstr[pos] not in ".,":
            raise "Invalid microsecond separator"
        else:
            pos += 1
            if not tstr[pos:].forall(lambda c: c in ascii_digits):
                raise "Non-digit values in fraction"

            len_remainder = len_str - pos

            if len_remainder >= 6:
                to_parse = 6
            else:
                to_parse = len_remainder

            time_comps[3] = int(tstr[pos:(pos+to_parse)])
            if to_parse < 6:
                time_comps[3] *= _FRACTION_CORRECTION[to_parse-1]

    return (time_comps[0], time_comps[1], time_comps[2], time_comps[3])