# ISO 8601 Times
lang YYYY = r"[0-9]{4}"
lang MM = r"0[1-9]|1[0-2]"
lang DD = r"0[1-9]|[1-2][0-9]|3[0-1]"
lang CalendarFormat = YYYY MM DD | YYYY "-" MM "-" DD

lang WW = r"0[1-9]|[1-4][0-9]|5[0-3]"
lang D = r"[1-7]"
lang WeekFormat = YYYY "W" WW D? | YYYY "-W" WW ("-" D)?
lang DateStr = CalendarFormat | WeekFormat

type Year = {y: int | 0 <= y <= 9999}
type Month = {m: int | 1 <= m <= 12}
type Day = {d: int | 1 <= d <= 31}
type Date = (Year, Month, Day)

def parse_iso_format_date(dtstr: DateStr) -> Date:
    # It is assumed that this is an ASCII-only string of lengths 7, 8 or 10.
    assert len(dtstr) in {7, 8, 10}
    year = int(dtstr[0:4])
    has_sep = dtstr[4] == '-'

    pos = 4 + (has_sep ? 1 : 0)
    if dtstr[pos:pos + 1] == "W":
        # YYYY-?Www-?D?
        pos += 1
        weekno = int(dtstr[pos:pos + 2])
        pos += 2

        dayno = 1
        if len(dtstr) > pos:
            if (dtstr[pos:pos + 1] == "-") != has_sep:
                raise "Inconsistent use of dash separator"

            pos += has_sep ? 1 : 0
            dayno = int(dtstr[pos:pos + 1])

        return _iso_week_to_gregorian(year, weekno, dayno)
    else:
        month = int(dtstr[pos:pos + 2])
        pos += 2
        if (dtstr[pos:pos + 1] == "-") != has_sep:
            raise "Inconsistent use of dash separator"

        pos += has_sep ? 1 : 0
        day = int(dtstr[pos:pos + 2])
        return (year, month, day)

type Week = {w: Int | 1 <= w <= 53}
type WeekDay = {d: Int | 1 <= d <= 7}

def _iso_week_to_gregorian(year: Year, week: Week, day: WeekDay) -> Date