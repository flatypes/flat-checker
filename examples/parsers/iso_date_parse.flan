lang Year = r"[0-9]{4}"
lang Month = r"0[1-9]|1[0-2]"
lang Day = r"0[1-9]|[12][0-9]|3[01]"
lang CalendarDate = Year Month Day | Year '-' Month '-' Day

lang Week = r"W(0[1-9]|[1-4][0-9]|5[0-3])"
lang Weekday = r"[1-7]"
lang WeekDate = Year Week Weekday? | Year '-' Week ('-' Weekday)?
lang Date = CalendarDate | WeekDate

/* Construct a date from a string in ISO 8601 format. */
method from_iso_format(date_string: Date) returns (year: int, month: int, day: int)
  ensures 0 <= year && year <= 9999
  ensures 1 <= month && month <= 12
  ensures 1 <= day && day <= 31
{
  if !date_string.isAscii {
    abort "Argument must be an ASCII str";
  }

  if |date_string| !in {7, 8, 10} {
    abort "Invalid isoformat string";
  }

  return _parse_iso_format_date(date_string);
}

method _parse_iso_format_date(dstr: Date) returns (year: int, month: int, day: int)
  ensures 0 <= year && year <= 9999
  ensures 1 <= month && month <= 12
  ensures 1 <= day && day <= 31
{
  // It is assumed that this is an ASCII-only string of lengths 7, 8 or 10
  assert |dstr| in {7, 8, 10};
  year = dstr[0:4].toInt;
  var has_sep = dstr[4] == '-';

  var pos = 4 + (has_sep ? 1 : 0);
  if (dstr[pos:pos + 1] == "W") {
    // YYYY-?Www-?D?
    pos += 1;
    var weekno = dstr[pos:pos + 2].toInt;
    pos += 2;

    var dayno = 1;
    if pos < |dstr| {
      if (dstr[pos:pos + 1] == "-") != has_sep {
        abort "Inconsistent use of dash separator";
      }

      pos += (has_sep ? 1 : 0);
      dayno = dstr[pos:pos + 1].toInt;
    }

    return _iso_week_to_gregorian(year, weekno, dayno);

  } else {
    month = dstr[pos:pos + 2].toInt;
    pos += 2;
    if (dstr[pos:pos + 1] == "-") != has_sep {
      abort "Inconsistent use of dash separator";
    }

    pos += (has_sep ? 1 : 0);
    day = dstr[pos:pos + 2].toInt;
  }
}

method _iso_week_to_gregorian(year: int, week: int, day: int) returns (y: int, m: int, d: int)
  requires 0 <= year && year <= 9999
  requires 1 <= week && week <= 53
  requires 1 <= day && day <= 7
  ensures 0 <= y && y <= 9999
  ensures 1 <= m && m <= 12
  ensures 1 <= d && d <= 31
