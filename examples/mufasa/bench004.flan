const HEADINGPREFIX = ""
const squashedPrefix = "a"

method apply(input: String): String
{
  var line = input;
  var inProgressReport: Bool;
  var lastLine: String;
  var heading: String;
  if (line.startsWith("\r\u001b")) {
    line = line.substring(2, line.length);
    if ("[K" == line) {
      inProgressReport = true;
    }
    return "";
  }

  if (line.startsWith(squashedPrefix)) {
    line = line.substring(squashedPrefix.length, line.length);
    inProgressReport = false;
    lastLine = line;
    if (line.startsWith(HEADINGPREFIX)) {
      line = line.substring(HEADINGPREFIX.length, line.length);
      heading = line + " > ";
    } else {
      line = line;
    }
  } else if (inProgressReport) {
    inProgressReport = false;
    line = lastLine + line;
  } else {
    return "";
  }
  return line;
}