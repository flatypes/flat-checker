lang MethodName = r"(is|get)?[A-Z][A-Za-z0-9_]*"
lang PropertyName = r"[a-z][A-Za-z0-9_]*"

def property_name(method_name: MethodName) -> PropertyName:
    if method_name.startswith("is"):
        pn = method_name[len("is"):]
    elif method_name.startswith("get"):
        pn = method_name[len("get"):]
    else:
        pn = method_name

    x = pn[0:1].lower()
    y = pn[1:len(pn) + 1]
    return x + y
