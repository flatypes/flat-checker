lang Scheme = r"[A-Za-z][A-Za-z0-9+\-.]*"
lang RegNameChar = r"[A-Za-z0-9\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]"
lang IPLiteral = '[' r"[0-9A-Fa-f:.]+" ']'
lang URL = Scheme "://" (RegNameChar* | IPLiteral) '/' (RegNameChar | ':' | '@' | '/')*

lang ValidDomain = "www" RegNameChar* ".it"
lang DomainLine = ValidDomain '\n'

def parse_host(input: URL) -> DomainLine?:
    s = input.strip()
    if not s.startswith("https://"):
        return None

    s = s[8:]
    if s.startswith("["):
        return None

    index = s.find(":")
    if index != -1:
        return None

    index = s.find("/")
    host_name = s[:index].lower()
    if is_valid_domain(host_name):
        return host_name + "\n"
    else:
        return None

def is_valid_domain(input: str) -> bool:
    ensures lambda b: b == (input.startswith("www.") and input.endswith(".it"))
    if not input.startswith("www."):
        return False
    if input.endswith(".it"):
        return True
    return False

lang URLLines = (URL '\n')* URL?
lang DomainLines = DomainLine*

def parse(input: URLLines) -> DomainLines:
    s = input
    domains: DomainLines = ""
    while len(s) > 0:
        index = s.find("\n")
        if index == -1:
            sub = s[0:len(s)]
            s = ""
        else:
            sub = s[:index]
            s = s[index + 1:]

        result = parse_host(sub)
        if result is not None:
            domains += result

    return domains
