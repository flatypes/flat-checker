lang Scheme = r"[A-Za-z][A-Za-z0-9+\-.]*"
lang RegNameChar = r"[A-Za-z0-9\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]"
lang IPLiteral = '[' r"[0-9A-Fa-f:.]+" ']'
lang URL = Scheme "://" (RegNameChar* | IPLiteral) '/' (RegNameChar | ':' | '@' | '/')*
lang ValidDomain = "www" RegNameChar* ".it"
lang ParsedDomain = (ValidDomain '\n')?

method parseHost(url: URL): ParsedDomain
{
  var input = url.trim();
  if (!input.startsWith("https://")) {
    return "";
  }

  input = input.substring(8, input.length);
  if (input.charAt(0) == '[') {
    return "";
  }

  var index = input.indexOf(":");
  if (index != -1) {
    return "";
  }

  index = input.indexOf("/");
  var hostName = input.substring(0, index).toLower();
  if (isValidDomain(hostName)) {
    return hostName + "\n";
  } else {
    return "";
  }
}

method isValidDomain(input: String): Bool
  ensures _ == (input.startsWith("www.") && input.endsWith(".it"))
{
  if (!input.startsWith("www.")) {
    return false;
  } else if (input.endsWith(".it")) {
    return true;
  }

  return false;
}

lang Lines = (URL '\n')* URL?
lang ParsedDomains = (ValidDomain '\n')*

method parse(lines: Lines): ParsedDomains
{
  var s: Lines = lines;
  var domains: ParsedDomains = "";
  while (s.length > 0)
  {
    var index = s.indexOf("\n");
    var sub: String;
    if (index == -1) {
      sub = s.substring(0, s.length);
      s = "";
    } else {
      sub = s.substring(0, index);
      s = s.substring(index + 1, s.length);
    }
    var result = parseHost(sub);
    if (result != "") {
      domains = domains + result;
    }
  }

  return domains;
}
