lang NoCurlies = r"[^{]*"

def remove_curlies(input: str) -> NoCurlies:
    result: NoCurlies = ""
    skip = False
    i = 0
    while len(input) > i + 1:
        invariant 0 <= i
        c = input[i]
        if c == '{':
            skip = True
        if not skip:
            result += c
        if c == '}':
            skip = False
        i += 1

    return result
