lang Code = r"[A-Z]{3}"
lang Name = r"[A-Z][a-z]+"
lang Station = Code r"[a-z]*;" Name
lang Formatted = Code ": " Name

def fix_stations(stations: List[Station]) -> List[Formatted]:
    result: List[Formatted] = []
    i = 0
    while i < len(stations):
        invariant 0 <= i <= len(stations)
        input = stations[i]
        code = input[:3]
        semi_c = input.find(';')
        name = input[semi_c+1:]
        result += code + ": " + name
        i += 1

    return result
