def normalize_log_line(line: str) -> str:
    ensures lambda s: s.startswith("ERROR") or s.startswith("WARN") or s == line
    if "ERROR" in line:
        return line[line.find("ERROR") : len(line)]
    elif "WARN" in line:
        return line[line.find("WARN") : len(line)]
    else:
        return line
