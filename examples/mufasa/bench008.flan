lang Word = r"[A-Za-z0-9_.:]+"
lang Path = Word ('/' Word)*
lang Input = Word '/' Path
lang Coerced = "file://" Path

method coerceLocalScriptURL(input: Input): Coerced
{
  var scriptURL = input;
  if (scriptURL.startsWith("assets://")) {
    assert false;
  }

  scriptURL = scriptURL.substring(scriptURL.indexOf("/") + 1, scriptURL.length);
  if (!scriptURL.contains("://")) {
    scriptURL = "file://" + scriptURL;
  }

  return scriptURL;
}