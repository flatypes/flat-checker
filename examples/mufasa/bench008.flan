lang Segment = r"[a-zA-Z0-9\-._~!$&'()*+,;=:@]+"
lang Path = Segment ('/' Segment)*
lang URL = "assets://"? Path
lang FileURL = "file://" Path

def coerce_local_script_url(script_url: URL) -> FileURL?:
    if script_url.startswith("assets://"):
        return None

    s = script_url[script_url.find("/") + 1:]
    if "://" not in s:
        s = "file://" + script_url

    return s
