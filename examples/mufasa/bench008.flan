method coerceLocalScriptURL(scriptURL: String): String
  requires !scriptURL.contains("://") && scriptURL.contains("/")
  ensures _.startsWith("file://")
{
  if (scriptURL.startsWith("assets://")) {
    return "null";
  } else {
    scriptURL = scriptURL.substring(scriptURL.indexOf("/") + 1, scriptURL.length);
    if (!scriptURL.contains("://")) {
      scriptURL = "file://" + scriptURL;
    }

    return scriptURL;
  }
}