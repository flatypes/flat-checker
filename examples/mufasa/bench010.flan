lang Present = r"[0-9]+(jaj|jar|DIS)?"
lang Future = r"[0-9]+(leS|waQ|nem| pId)?"

def translate_future(present: Present) -> Future:
    time: str = present
    if present.find("jaj") != -1:
        time = time[:len(time)-3] + "leS"
    elif present.find("jar") != -1:
        time = time[:len(time)-3] + "waQ"
    elif present.find("DIS") != -1:
        time = time[:len(time)-3] + "nem"
    else:
        time = time + " pId"

    return time
