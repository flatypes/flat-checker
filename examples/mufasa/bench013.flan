lang Scheme = r"[A-Za-z][A-Za-z0-9+\-.]*"
lang RegNameChar = r"[A-Za-z0-9\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]"
lang URL = Scheme "://" RegNameChar*
lang Domain = r"([a-z0-9\-._~]|%[0-9a-f][0-9a-f]|[!$&'()*+,;=])*"

def parse_host(input: URL) -> Domain?:
    s = input.strip().lower()
    if not s.startswith("https://"):
        return None

    s = s[8:]
    if not s.startswith("www."):
        domain: Domain? = None
    elif s.endswith(".it"):
        domain = s[4:len(s)-3]
    else:
        domain = None
    return domain

lang URLLines = (URL '\n')* URL?

def parse_first_domain(input: URLLines) -> Domain?:
    s = input
    stop = False
    while not stop:
        if len(s) == 0:
            stop = True
            result: Domain? = None
        else:
            index = s.find("\n")
            if index == -1:
                sub = s[0:len(s)]
                s = ""
            else:
                sub = s[0:index]
                s = s[index + 1:]

            result = parse_host(sub)
            if result is not None:
                stop = True

    return result
