lang Scheme = r"[A-Za-z][A-Za-z0-9+\-.]*"
lang RegNameChar = r"[A-Za-z0-9\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]"
lang URL = Scheme "://" RegNameChar*
lang Domain = r"([a-z0-9\-._~]|%[0-9a-f][0-9a-f]|[!$&'()*+,;=])*"

method parseHost(url: URL): Domain
{
  var input = url.trim();
  input = input.toLower();
  var r: String;
  if (!input.startsWith("https://")) {
    r = "";
  } else {
    input = input.substring(8, input.length);
    if (!input.startsWith("www.")) {
      r = "";
    } else if (input.endsWith(".it")) {
      var domain = input.substring(4, input.length - 3);
      r = domain;
    } else {
      r = "";
    }
  }

  return r;
}

lang Lines = (URL '\n')* URL?

method parseFirstDomain(lines: Lines): Domain
{
  var s: Lines = lines;
  var stop = false;
  var result: Domain;
  while (!stop)
  {
    if (s.length == 0) {
      stop = true;
      result = "";
    } else {
      var index = s.indexOf("\n");
      var sub: String;
      if (index == -1) {
        sub = s.substring(0, s.length);
        s = "";
      } else {
        sub = s.substring(0, index);
        s = s.substring(index + 1, s.length);
      }

      result = parseHost(sub);
      if (result != "") {
        stop = true;
      }
    }
  }

  return result;
}