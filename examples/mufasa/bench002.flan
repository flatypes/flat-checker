def count_line(s: str, kdx: int) -> int:
    requires 0 <= kdx < len(s)
    ensures lambda n: n == s[:kdx+1].count('\n') + 1
    c = 1
    i = kdx
    while i > -1:
        invariant -1 <= i <= kdx
        invariant c == s[i+1:kdx+1].count('\n') + 1
        if s[i] == '\n':
            c += 1
        i -= 1
    return c
