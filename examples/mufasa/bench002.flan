method countLine(s: String, kdx: Int): Int
  requires 0 <= kdx && kdx < |s|
  ensures _ == s[:kdx + 1].count('\n') + 1
{
  var c = 1;
  var i = kdx;
  while (i > -1)
    invariant -1 <= i && i <= kdx
    invariant c == s[i + 1:kdx + 1].count('\n') + 1
  {
    if (s.charAt(i) == '\n') {
      c = c + 1;
    }
    i = i - 1;
  }
  return c;
}