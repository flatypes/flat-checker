lang Present = r"[0-9]+(jaj|jar|DIS)?"
lang Past = r"[0-9]+(Hu|wen|ben| ret)?"

def translate_past(present: Present) -> Past:
    time: str = present
    if present.find("jaj") != -1:
        time = time[:len(time)-3] + "Hu"
    elif present.find("jar") != -1:
        time = time[:len(time)-3] + "wen"
    elif present.find("DIS") != -1:
        time = time[:len(time)-3] + "ben"
    else:
        time = time + " ret"

    return time
