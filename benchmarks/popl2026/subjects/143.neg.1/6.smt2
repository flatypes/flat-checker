; Input: /benchmark/subjects/143.neg.1.py
(set-logic ALL)
(declare-const s String)
(declare-const i@1 Int)
(assert (str.in_re s (re.* (re.diff re.allchar (str.to_re "a")))))
(assert (<= i@1 0))
(assert (<= 0 i@1))
(assert (<= i@1 (str.len s)))
(assert (not (str.contains (str.substr s i@1 (- (str.len s) i@1)) "a")))
(assert (not false))
(check-sat)
(exit)