(set-logic ALL)
(declare-const s String)
(assert (str.in_re s (re.++ (re.opt (str.to_re "a")) (re.opt (str.to_re "b")))))
(assert (distinct (str.len s) 0))
(assert (= (str.at s 0) "a"))
(assert (>= 0 0))
(assert (< 0 (str.len s)))
(assert (distinct (str.len s) 1))
(assert (= (str.len s) 2))
(assert (>= 1 0))
(assert (< 1 (str.len s)))
(assert (not (= (str.at s 1) "b")))
(check-sat)
(exit)