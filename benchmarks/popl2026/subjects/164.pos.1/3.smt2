; Input: /benchmark/subjects/164.pos.1.py
(set-logic ALL)
(declare-const s String)
(assert (str.in_re s (re.opt (re.diff re.allchar (str.to_re "a")))))
(assert (distinct s ""))
(assert (distinct (str.at s 0) "a"))
(assert (>= 0 0))
(assert (< 0 (str.len s)))
(assert (not (= (str.len s) 1)))
(check-sat)
(exit)